#!/usr/bin/env bash
# Configures local name resolution rules for localhost and facebook.com in /etc/hosts

# Replace the standard loopback IP for localhost to 127.0.0.2 if present, or append it
if grep -q "localhost" /etc/hosts; then
    sed -i 's/^[0-9.]\+\s\+localhost/127.0.0.2 localhost/g' /etc/hosts
else
    echo "127.0.0.2 localhost" >> /etc/hosts
fi

# Replace or add the custom resolution rule for facebook.com to point to 8.8.8.8
if grep -q "facebook.com" /etc/hosts; then
    sed -i 's/^[0-9.]\+\s\+facebook.com/8.8.8.8 facebook.com/g' /etc/hosts
else
    echo "8.8.8.8 facebook.com" >> /etc/hosts
fi
