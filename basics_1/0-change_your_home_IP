#!/usr/bin/env bash
# Configures local name resolution rules for localhost and facebook.com in /etc/hosts

# Read the current file, modify the patterns using a stream, and overwrite it safely
if grep -q "localhost" /etc/hosts; then
    cp /etc/hosts /tmp/hosts.tmp
    sed 's/^[0-9.]\+\s\+localhost/127.0.0.2 localhost/g' /tmp/hosts.tmp > /etc/hosts
else
    echo "127.0.0.2 localhost" >> /etc/hosts
fi

if grep -q "facebook.com" /etc/hosts; then
    cp /etc/hosts /tmp/hosts.tmp
    sed 's/^[0-9.]\+\s\+facebook.com/8.8.8.8 facebook.com/g' /tmp/hosts.tmp > /etc/hosts
else
    echo "8.8.8.8 facebook.com" >> /etc/hosts
fi

# Clean up the temporary file
[ -f /tmp/hosts.tmp ] && rm /tmp/hosts.tmp
